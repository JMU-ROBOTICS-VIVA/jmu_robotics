#!/usr/bin/env python3

import math
import sys

import rclpy
from rclpy.node import Node
from rclpy.utilities import remove_ros_args

from sensor_msgs.msg import JointState


def main():

    # Remove ROS-specific arguments before processing our arguments.
    args = remove_ros_args(args=sys.argv)

    if len(args) != 3:
        print(
            'Usage:\n'
            '  ros2 run jmu_cs354_arm set_joints '
            '<shoulder_degrees> <elbow_degrees>\n\n'
            'Example:\n'
            '  ros2 run jmu_cs354_arm set_joints 90 45'
        )
        return

    try:
        shoulder_degrees = float(args[1])
        elbow_degrees = float(args[2])
    except ValueError:
        print('ERROR: Joint angles must be numbers.')
        return

    shoulder_radians = math.radians(shoulder_degrees)
    elbow_radians = math.radians(elbow_degrees)

    rclpy.init()

    node = Node('set_joints')

    publisher = node.create_publisher(
        JointState,
        '/arm_joint_command',
        10
    )

    #
    # Wait until the joint state publisher GUI has been
    # discovered by DDS.
    #
    try:
        while publisher.get_subscription_count() == 0:
            print(
                'Waiting for joint_state_publisher_gui...',
                end='\r',
                flush=True
            )

            rclpy.spin_once(
                node,
                timeout_sec=0.1
            )

    except KeyboardInterrupt:
        print('\nCancelled.')

        node.destroy_node()
        rclpy.shutdown()
        return

    #
    # Construct the joint command.
    #
    msg = JointState()

    msg.header.stamp = node.get_clock().now().to_msg()

    msg.name = [
        'shoulder_joint',
        'elbow_joint'
    ]

    msg.position = [
        shoulder_radians,
        elbow_radians
    ]

    #
    # Publish the command.
    #
    
    # Publish repeatedly for one second.
    for _ in range(10):
        msg.header.stamp = node.get_clock().now().to_msg()
        publisher.publish(msg)

        rclpy.spin_once(node, timeout_sec=0.1)
    #
    # Keep this short-lived node alive briefly so DDS has
    # an opportunity to deliver the message.
    #
    for _ in range(5):
        rclpy.spin_once(
            node,
            timeout_sec=0.1
        )

    print(' ' * 60, end='\r')

    print(
        f'shoulder_joint = {shoulder_degrees:.1f} deg '
        f'({shoulder_radians:.4f} rad)')

    print(
        f'elbow_joint    = {elbow_degrees:.1f} deg '
        f'({elbow_radians:.4f} rad)'
    )

    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
